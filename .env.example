# OpenMAIC deployment configuration — Alibaba Cloud Bailian (QWEN)
# 复制为 .env.local，填写百炼密钥。部署配置统一维护在 env 中。
# QWEN_API_KEY 可供大模型、图片和 TTS 共用；专用密钥仅在需要时填写。

# --- Feature Flags / 功能开关 ---
FEATURE_TEACHER_EXTENSION=true
FEATURE_LESSON_GENERATION=true
FEATURE_RICH_COURSEWARE=true
FEATURE_QUIZ_GENERATION=true
FEATURE_PBL_GENERATION=true
FEATURE_REALTIME_ANSWER=true
FEATURE_ONLINE_SCORING=true
FEATURE_CLASSROOM_FEEDBACK=true
FEATURE_PPTX_EXPORT=true
FEATURE_WHITEBOARD=false
FEATURE_VOICE_NARRATION=false
FEATURE_VOICE_PLAYBACK=false
FEATURE_FOLLOW_PRESENTER=false
FEATURE_COMPLEX_REALTIME_PLAYBACK=false

# --- QWEN LLM / 百炼大模型 ---
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODELS=qwen3.7-flash
DEFAULT_MODEL=qwen:qwen3.7-flash

# --- QWEN Image / 百炼图片生成 ---
# 专用图片密钥可留空，默认复用 QWEN_API_KEY。
IMAGE_QWEN_IMAGE_API_KEY=
IMAGE_QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
IMAGE_QWEN_IMAGE_MODELS=qwen-image-2.0-pro-2026-03-03,qwen-image-2.0-2026-03-03
DEFAULT_IMAGE_PROVIDER=qwen-image
DEFAULT_IMAGE_MODEL=qwen-image-2.0-2026-03-03

# --- QWEN TTS / 百炼语音合成 ---
# 专用 TTS 密钥可留空，默认复用 QWEN_API_KEY。
TTS_QWEN_API_KEY=
TTS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_QWEN_MODELS=qwen3-tts-flash
DEFAULT_TTS_PROVIDER=qwen-tts
DEFAULT_TTS_VOICE=Cherry

# --- Browser ASR / 浏览器语音识别 ---
DEFAULT_ASR_PROVIDER=browser-native
DEFAULT_ASR_LANGUAGE=zh-CN

# --- Runtime / 运行设置 ---
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_MAIC_EDITOR_ENABLED=1
# LOG_LEVEL=info
# LOG_FORMAT=pretty
# LLM_THINKING_DISABLED=false
# PARALLEL_SCENE_CONCURRENCY=3
# HTTP_PROXY=
# HTTPS_PROXY=

# 可选：阶段模型覆盖也必须使用 env 中已配置的 QWEN 模型。
# MODEL_ROUTES='{"scene-outlines-stream":{"model":"qwen:qwen3.7-flash","thinking":{"mode":"disabled"}}}'

# --- Access Control / 访问控制 ---
# ACCESS_CODE=your-access-code
# 未设置时沿用项目默认设置页密码；部署时可自行替换。
SETTINGS_PASSWORD=bingo@666
